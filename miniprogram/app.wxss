page {
  min-height: 100%;
  background: #f5f6f8;
  color: #20242a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, image, picker, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(23, 30, 41, 0.06);
}

.muted {
  color: #8b9098;
}

.price {
  color: #e85d36;
  font-weight: 700;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #f1794f, #e84a27);
  box-shadow: 0 12rpx 28rpx rgba(232, 74, 39, 0.22);
}

.btn-primary[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #c9cdd3;
  box-shadow: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  color: #333941;
  border: 1rpx solid #e5e8ec;
  border-radius: 40rpx;
  background: #ffffff;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 120rpx 32rpx;
  color: #9aa0a8;
  text-align: center;
}

.empty-icon {
  margin-bottom: 24rpx;
  font-size: 88rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.form-card {
  margin: 24rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  width: 170rpx;
  color: #555b64;
}

.form-input {
  flex: 1;
  height: 80rpx;
  text-align: right;
}

.form-textarea {
  flex: 1;
  height: 150rpx;
  padding: 24rpx 0;
  text-align: left;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.stepper button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  color: #e85d36;
  font-size: 38rpx;
  line-height: 1;
  border-radius: 50%;
  background: #fff2ed;
}

.stepper button.minus {
  color: #666d76;
  background: #f1f2f4;
}

.stepper .qty {
  min-width: 32rpx;
  color: #20242a;
  font-weight: 600;
  text-align: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  color: #e85d36;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: #fff0ea;
}

.demo-banner {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 22rpx;
  color: #8b5a12;
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: 16rpx;
  background: #fff7dd;
}

.icp-footer {
  padding: 30rpx 24rpx 40rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a2a8b0;
  text-align: center;
}
