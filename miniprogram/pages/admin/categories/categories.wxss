.categories-page {
  padding: 24rpx;
}

.add-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(23, 30, 41, 0.05);
}

.card-head {
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 7rpx;
  color: #989da5;
  font-size: 21rpx;
}

.add-row {
  display: flex;
  gap: 12rpx;
}

.name-input,
.sort-input {
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 25rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
}

.name-input {
  flex: 1;
}

.sort-input {
  width: 116rpx;
  text-align: center;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 76rpx;
  color: #ffffff;
  font-size: 25rpx;
  border-radius: 16rpx;
  background: #e85d36;
}

.category-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 20rpx 70rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(23, 30, 41, 0.04);
}

.category-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 50%;
  background: #252a31;
}

.category-main {
  flex: 1;
  min-width: 0;
}

.category-name-input {
  height: 50rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.category-meta {
  margin-top: 6rpx;
  color: #9a9fa7;
  font-size: 20rpx;
}

.sort-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #959aa2;
  font-size: 20rpx;
}

.sort-wrap input {
  width: 70rpx;
  height: 52rpx;
  font-size: 23rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f5f6f8;
}

.category-card switch {
  transform: scale(0.72);
}

.category-actions {
  position: absolute;
  right: 22rpx;
  bottom: 18rpx;
  display: flex;
  gap: 26rpx;
  color: #e85d36;
  font-size: 22rpx;
}

.danger {
  color: #d24b35;
}

.loading {
  padding: 120rpx 0;
  color: #9ba0a8;
  text-align: center;
}
