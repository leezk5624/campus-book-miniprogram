.edit-page {
  padding: 24rpx 24rpx 60rpx;
}

.copy-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  color: #8b5a12;
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 18rpx;
  background: #fff7dd;
}

.cover-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 34rpx rgba(23, 30, 41, 0.05);
}

.cover-preview {
  position: relative;
  flex: none;
  width: 200rpx;
  height: 266rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #fff6e8, #f2e2cd);
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
  height: 100%;
  color: #a2a7ae;
  font-size: 22rpx;
}

.cover-emoji {
  font-size: 72rpx;
}

.cover-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8rpx 0;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  background: rgba(24, 29, 36, 0.55);
}

.uploading-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  background: rgba(24, 29, 36, 0.55);
}

.cover-side {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.cover-title {
  color: #20242a;
  font-size: 28rpx;
  font-weight: 700;
}

.cover-tip {
  margin-top: 10rpx;
  color: #969ba3;
  font-size: 21rpx;
  line-height: 1.55;
}

.cover-buttons {
  display: flex;
  gap: 14rpx;
  margin-top: auto;
  padding-top: 18rpx;
}

.cover-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  color: #4f5660;
  font-size: 24rpx;
  border: 1rpx solid #e3e6ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.cover-btn.primary {
  color: #ffffff;
  border-color: #e85d36;
  background: #e85d36;
}

.cover-btn[disabled] {
  opacity: 0.6;
}

.cover-note {
  margin-top: 12rpx;
  color: #b0b4ba;
  font-size: 20rpx;
}

.form-card {
  margin: 0 0 22rpx;
  padding: 0 28rpx 10rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 34rpx rgba(23, 30, 41, 0.05);
}

.card-title {
  padding: 26rpx 0 8rpx;
  color: #20242a;
  font-size: 27rpx;
  font-weight: 700;
}

.required {
  color: #d94a33;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.emoji-input {
  font-size: 34rpx;
}

.text-card {
  padding-bottom: 26rpx;
}

.field-block {
  padding: 18rpx 0 6rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #555b64;
  font-size: 25rpx;
}

.counter {
  color: #a8adb4;
  font-size: 21rpx;
}

.short-input {
  width: 100%;
  height: 120rpx;
  padding: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.intro-input {
  width: 100%;
  min-height: 260rpx;
  padding: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.save-wrap {
  padding: 20rpx 0 40rpx;
}

.loading {
  padding: 150rpx 0;
  color: #999fa7;
  text-align: center;
}
